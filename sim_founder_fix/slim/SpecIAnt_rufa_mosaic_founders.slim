1 late() {
	// output a VCF with all pure founder individuals - without unmated males (as they are not founders)
	// get all mated founder individuals
	founders = c(p1.subsetIndividuals(sex="F", maxAge=0), p1000.subsetIndividuals(sex="M", maxAge=0));
	
	// tag for founders VCF file
	VCF_founders = paste0(folder, "/pureFounders_ckl", sim.cycle, "_", TAG, ".vcf");
	founders.outputIndividualsToVCF(filePath=VCF_founders);
}

sampleCycle late() {
	// output every 10 cycles and tick 1
	// get all new mated + unmated males
	males   = c(p1.subsetIndividuals(sex="M", maxAge=0),p1000.subsetIndividuals(sex="M", maxAge=0));
	// get new queens
	females = p1.subsetIndividuals(sex="F", maxAge=0);
	
	// get mutations frequencies for each mutation type
	muts = sim.mutations;
	// only haplosomes in males
	haplosomes = males.haplosomesForChromosomes(includeNulls = F);
	// get mutation frequency in males
	freqs = haplosomes.mutationFrequenciesInHaplosomes(muts);
	
	// output allele frequencies for each mutation type in males
	for (i in seqAlong(muts)) {
		mut = muts[i];
		af  = freqs[i];
		
		line = paste(
			sim.cycle,
			"M",
			mut.mutationType.id,
			mut.chromosome.id,
			mut.position,
			freqs[i],
			sep=" "
			);
		writeFile(AF_FILE, line, append=T);
	}
	
	// get haplosomes in females
	haplosomes = females.haplosomesForChromosomes(includeNulls = F);
	// get mutation frequencies in females
	freqs = haplosomes.mutationFrequenciesInHaplosomes(muts);
	
	// output mutation frequencies in females
	for (i in seqAlong(muts)) {
		mut = muts[i];
		af  = freqs[i];
		
		line = paste(
			sim.cycle,
			"F",
			mut.mutationType.id,
			mut.chromosome.id,
			mut.position,
			freqs[i],
			sep=" "
			);
		
		writeFile(AF_FILE, line, append=T);
	}
}


// for outputting 012 genotype matrices //
sampleCycle late() {
	if(T){
		
		ckl = paste0("ckl",sim.cycle,"_",prefix);
		// males: mated & unmated //
		males = c(p1.subsetIndividuals(maxAge=0),p1000.subsetIndividuals(maxAge=0));
		males = sample(males,min(length(males),sampleSize),F);
		
		// output VCF file for sampled males
		VCF_males = paste0(folder, "/males_ckl", sim.cycle, "_", TAG, ".vcf");
		males.outputIndividualsToVCF(filePath=VCF_males);
		
		// separately by chromosome - concatenated into a single genome for output //
		h_M = males.haplosomesForChromosomes(includeNulls = F);
		
		// new queens
		females = p1.subsetIndividuals(sex = "F",maxAge=0);
		females = sample(females,min(length(females),sampleSize),F);
		
		// output VCF file for sampled females
		VCF_females = paste0(folder, "/females_ckl", sim.cycle, "_", TAG, ".vcf");
		females.outputIndividualsToVCF(filePath=VCF_females);
		
		// separately by chromosome - concatenated into a single genome for output //
		h_F = females.haplosomesForChromosomes();
		
		// we are interested in all mutations in any of these individuals
		h = c(h_M,h_F);
		
		// get the unique mutations
		if(!isNULL(sampleCycle_full)){
			if(match(sim.cycle,sampleCycle_full)>=0){
				
				m = sortBy(unique(h.mutations,preserveOrder=F), "position");
			
			}else{
				
				m = NULL;
				for(mutType in c(m5,m6,m7,m8)){
					
					m = c(m,sortBy(unique(h.mutationsOfType(mutType),preserveOrder=F), "position"));
				
				}
			}
		
		}else{
			m = NULL;
			for(mutType in c(m5,m6,m7,m8)){
				
				m = c(m,sortBy(unique(h.mutationsOfType(mutType),preserveOrder=F), "position"));
			
			}
		}
		
		
		// First two rows will be chromosome and position //
		// chromsome
		
		writeFile(paste0(folder, ckl  ,"_M.012"), 	paste(m.chromosome.id) , append=T);
		// position
		writeFile(paste0(folder, ckl  ,"_M.012"), 	paste(m.position),  append=T);
		// mutationType
		writeFile(paste0(folder, ckl  ,"_M.012"), 	paste(m.mutationType.id), append=T);
		// Cycle through individuals and write haplosome for each, concatenating the chromosomes //
		
		for (x in (1:size(males))-1)
		{
			hasMuts = (match(m, males[x].haploidGenome1.mutations) >= 0);
			
			gts = paste(asInteger(hasMuts), sep=" ");
			
			writeFile(paste0(folder, ckl ,"_M.012"), gts , append=T);
		
		}
		
		// Repeat for females (that have two haplosomes per individual) //
		
		// First two rows will be chromosome and position //
		// chromsome
		
		writeFile(paste0(folder, ckl  ,"_F.012"), 	paste(m.chromosome.id),  append=T);
		// position
		writeFile(paste0(folder, ckl  ,"_F.012"), 	paste(m.position), append=T);
		// mutationType
		writeFile(paste0(folder, ckl  ,"_F.012"), 	paste(m.mutationType.id),  append=T);
		
		// Cycle through individuals and write haplosome for each, concatenating the chromosomes //
		
		for (x in 1:size(females)-1)
		{
			// separately for each haplosome for females
			hasMuts = (match(m, females[x].haploidGenome1.mutations) >= 0);
			
			gts = paste(asInteger(hasMuts), sep=" ");
			
			writeFile(paste0(folder, ckl ,"_F.012"), gts , append=T);
			
			hasMuts = (match(m, females[x].haploidGenome2.mutations) >= 0);
			
			gts = paste(asInteger(hasMuts), sep=" ");
			
			writeFile(paste0(folder, ckl ,"_F.012"), gts , append=T);
		}
	}
}


sampleCycle late() {
	
	// Ancestry for males
	males= p1000.subsetIndividuals(maxAge=0);
	
	n = size(males);
	if (n  != 0){
		z = males.countOfMutationsOfType(m10) / nAncInf;  // vector, one per male
		zNtrl = mean(z);
		// sd_zNtrl   = sd(z);
		sd_zNtrl = (size(z) > 1) ? sd(z) else "NA"; // output 0 for adtandard deviation if only one individual present.
		
		z = males.countOfMutationsOfType(m50) / nQTN;  // vector, one per male
		zQTN= mean(z);
		// sd_zQTN   = sd(z);
		sd_zQTN  = (size(z) > 1) ? sd(z) else "NA";
		
		line = paste(sim.cycle, "M_mat",n, zQTN, sd_zQTN, zNtrl, sd_zNtrl, sep=" ");
		writeFile(ANC_FILE, line, append=T);
	
	}else{
		
		line = paste(sim.cycle, "M_mat",0, "NA", "NA", "NA", "NA", sep=" ");
		writeFile(ANC_FILE, line, append=T);
	}
	
	males= p1.subsetIndividuals(sex = "M");
	
	n = size(males);
	if (n  != 0){
		z = males.countOfMutationsOfType(m10) / nAncInf;  // vector, one per male
		zNtrl = mean(z);
		sd_zNtrl = (size(z) > 1) ? sd(z) else "NA";
		
		z = males.countOfMutationsOfType(m50) / nQTN;  // vector, one per male
		zQTN= mean(z);
		sd_zQTN  = (size(z) > 1) ? sd(z) else "NA";
		
		line = paste(sim.cycle, "M_unmat",n, zQTN, sd_zQTN, zNtrl, sd_zNtrl, sep=" ");
		writeFile(ANC_FILE, line, append=T);
	
	}else{
		
		line = paste(sim.cycle, "M_unmat",0, "NA", "NA", "NA", "NA", sep=" ");
		writeFile(ANC_FILE, line, append=T);
	}
	
	females = p1.subsetIndividuals(sex="F");
	n = size(females);
	
	if (n  != 0){
		z = females.countOfMutationsOfType(m10) / nAncInf / 2;  // vector, one per male
		zNtrl = mean(z);
		sd_zNtrl = (size(z) > 1) ? sd(z) else "NA";
		
		z = females.countOfMutationsOfType(m50) / nQTN / 2;  // vector, one per male
		zQTN= mean(z);
		sd_zQTN  = (size(z) > 1) ? sd(z) else "NA";
		
		line = paste(sim.cycle, "F",n, zQTN, sd_zQTN, zNtrl, sd_zNtrl, sep=" ");
		writeFile(ANC_FILE, line, append=T);
	
	}else{
		
		line = paste(sim.cycle, "M",0, "NA", "NA", "NA", "NA", sep=" ");
		writeFile(ANC_FILE, line, append=T);
	}

}


